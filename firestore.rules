rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMember(householdId) {
      return signedIn() &&
        email() in get(/databases/$(database)/documents/households/$(householdId)).data.memberEmails;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{householdId} {
      allow read: if signedIn() && email() in resource.data.memberEmails;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && email() in request.resource.data.memberEmails;
      // Members can edit; the owner can't be removed and nobody can take over ownership.
      allow update: if signedIn()
        && email() in resource.data.memberEmails
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.ownerEmail in request.resource.data.memberEmails;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /{collection}/{docId} {
        allow read, write: if collection in ['recipes', 'items', 'plan'] && isMember(householdId);
      }
    }
  }
}
